# Copy to .env and fill in. .env is gitignored.

# Claude (generation + judge). Optional if you've run `ant auth login`.
ANTHROPIC_API_KEY=

# Local LLM fallback
OLLAMA_HOST=http://localhost:11434

# Leave unset to use embedded Qdrant under storage/qdrant (no Docker needed)
# QDRANT_URL=http://localhost:6333
